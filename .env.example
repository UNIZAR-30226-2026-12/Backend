# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env)
# ==========================================
# Cópialo como ".env" e introduce tus datos reales para poder lanzar el backend.
# ¡NUNCA subas el archivo ".env" real con las contraseñas al repositorio!

# ------------------------------------------
# DESPLIEGUE DEL FRONTEND
# ------------------------------------------
# URL del repositorio del frontend (usada habitualmente en Portainer u otros servidores).
# Si desarrollas en local con Docker Desktop y quieres usar tus archivos locales, coméntalo o déjalo vacío.
# FRONTEND_CONTEXT=https://github.com/UNIZAR-30226-2026-12/Frontend-Web.git#main

# ------------------------------------------
# BASE DE DATOS
# ------------------------------------------
# URL de conexión a la base de datos PostgreSQL (Obligatorio).
DATABASE_URL=postgresql://usuario:contrasena@tu-host.com:6543/postgres?sslmode=require

# ------------------------------------------
# RECUPERACIÓN DE CONTRASEÑAS (SMTP)
# ------------------------------------------
# Cuenta de Gmail desde la cual se enviarán los correos (Obligatorio).
SMTP_USER=tu_correo@gmail.com

# "Contraseña de aplicación" generada desde la seguridad de tu cuenta de Google (Obligatorio).
# ¡Ojo! No es tu contraseña habitual de Gmail.
SMTP_PASSWORD=tu_contrasena_de_aplicacion

# ------------------------------------------
# SEGURIDAD Y TOKENS (JWT)
# ------------------------------------------
# Clave secreta para firmar digitalmente las sesiones de los usuarios (Obligatorio).
# Se recomienda un texto largo y aleatorio (por ej. un hash de 32 caracteres).
SECRET_KEY=escribe_aqui_una_cadena_secreta_aleatoria_y_larga
